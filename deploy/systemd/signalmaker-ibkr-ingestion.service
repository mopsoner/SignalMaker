[Unit]
Description=SignalMaker IBKR stock/ETF ingestion worker
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/signalmaker
Environment=SIGNALMAKER_LOG_DIR=/opt/signalmaker/logs
ExecStart=/bin/bash /opt/signalmaker/scripts/start_ibkr_ingestion_worker.sh
StandardOutput=append:/opt/signalmaker/logs/ibkr_ingestion.log
StandardError=append:/opt/signalmaker/logs/ibkr_ingestion.log
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
