[Unit]
Description=SignalMaker Scheduler worker
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/signalmaker
Environment=SIGNALMAKER_LOG_DIR=/opt/signalmaker/logs
Environment=SIGNALMAKER_WORKER_SUPERVISOR=systemd
ExecStart=/bin/bash /opt/signalmaker/scripts/start_scheduler_worker.sh
StandardOutput=append:/opt/signalmaker/logs/scheduler.log
StandardError=append:/opt/signalmaker/logs/scheduler.log
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
