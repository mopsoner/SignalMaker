[Unit]
Description=SignalMaker Pipeline worker
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/signalmaker
Environment=SIGNALMAKER_LOG_DIR=/opt/signalmaker/logs
ExecStart=/bin/bash /opt/signalmaker/scripts/start_pipeline_worker.sh
StandardOutput=append:/opt/signalmaker/logs/pipeline.log
StandardError=append:/opt/signalmaker/logs/pipeline.log
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
