[Unit]
Description=SignalMaker live Kraken momentum executor
After=network-online.target signalmaker-momentum-engine.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/signalmaker
Environment=SIGNALMAKER_LOG_DIR=/opt/signalmaker/logs
ExecStart=/bin/bash /opt/signalmaker/scripts/start_momentum_executor_worker.sh
StandardOutput=append:/opt/signalmaker/logs/momentum_executor.log
StandardError=append:/opt/signalmaker/logs/momentum_executor.log
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
