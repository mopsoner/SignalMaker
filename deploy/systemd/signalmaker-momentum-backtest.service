[Unit]
Description=SignalMaker Momentum backtest worker
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/signalmaker
Environment=SIGNALMAKER_LOG_DIR=/opt/signalmaker/logs
ExecStart=/bin/bash /opt/signalmaker/scripts/start_momentum_backtest_worker.sh
StandardOutput=append:/opt/signalmaker/logs/momentum_backtest.log
StandardError=append:/opt/signalmaker/logs/momentum_backtest.log
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
