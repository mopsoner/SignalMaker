[Unit]
Description=SignalMaker API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/signalmaker
Environment=SIGNALMAKER_LOG_DIR=/opt/signalmaker/logs
Environment=SIGNALMAKER_WORKER_SUPERVISOR=systemd
ExecStart=/bin/bash /opt/signalmaker/scripts/start_api.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
